, createObject('name', 'POSTGRES_USER', 'value', parameters('postgresAdminLogin'))), createArray()), if(parameters('deployAiFoundry'), createArray(createObject('name', 'AZURE_AI_FOUNDRY_ENDPOINT', 'value', reference(resourceId('Microsoft.CognitiveServices/accounts', variables('aiFoundryName')), '2024-10-01').endpoint), createObject('name', 'AZURE_OPENAI_ENDPOINT', 'value', reference(resourceId('Microsoft.CognitiveServices/accounts', variables('aiFoundryName')), '2024-10-01').endpoint), createObject('name', 'AZURE_OPENAI_CHAT_DEPLOYMENT', 'value', parameters('chatModelName')), createObject('name', 'AZURE_OPENAI_EMBEDDING_DEPLOYMENT', 'value', parameters('embeddingModelName'))), createArray()))]"
